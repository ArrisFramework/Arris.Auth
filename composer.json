{
    "name": "karelwintersky/arris.auth",
    "description": "Arris µFramework: standalone authentication with session cookies and bearer tokens",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Karel Wintersky",
            "email": "karel.wintersky@gmail.com"
        }
    ],
    "keywords": [
        "arris",
        "auth",
        "authentication",
        "session",
        "cookie",
        "bearer",
        "token"
    ],
    "config": {
        "optimize-autoloader": true,
        "platform-check": false,
        "sort-packages": true
    },
    "require": {
        "php": "^8.2",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10"
    },
    "suggest": {
        "karelwintersky/arris": "Arris µFramework",
        "ext-redis": "Required only for Arris\\Auth\\Session\\RedisSessionHandler"
    },
    "autoload": {
        "psr-4": {
            "Arris\\Auth\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    }
}
